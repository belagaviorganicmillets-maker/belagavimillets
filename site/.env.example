# Copy to .env and fill in once a real payment gateway account exists.
# NEVER commit the real .env file — it's already listed in .gitignore.
#
# This static frontend only ever reads a PUBLIC key (see
# js/data/payment-config.js). PAYMENT_KEY_SECRET must live on a backend/
# serverless function that verifies payments — it must never be shipped
# to the browser. This project does not currently include that backend;
# see README.md "Payment" section for what needs to be built before
# online payment can go live.


RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

BUSINESS_WHATSAPP_NUMBER=919164245475
